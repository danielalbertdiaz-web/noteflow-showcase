  "common": {
    "login": {
      "url": "https://www.kinnser.net/",
      "username_field": "#username",
      "password_field": "#password",
      "login_button": "#login-button",
      "totp_field": "input[name='totp_code']",
      "totp_submit": "button[type='submit']",
      "dashboard_indicator": "#main-dashboard",
      "sms_2fa_indicator": ".sms-verification-prompt",
      "sms_code_field": "input[name='sms_code']"
    },
    "patient_search": {
      "search_input": "#patient-search-input",
      "search_button": "#patient-search-btn",
      "results_container": "#patient-search-results",
      "result_row": ".patient-result-row",
      "patient_name_cell": ".patient-name",
      "patient_id_cell": ".patient-mrn"
    },
    "save": {
