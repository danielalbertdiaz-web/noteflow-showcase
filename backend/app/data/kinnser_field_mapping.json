{
  "version": "1.0.0",
  "last_verified": "2026-03-28",
  "visit_types": {
    "follow_up": {
      "navigation": {
        "clinical_tab": "#tab-clinical",
        "visit_note_section": "#visit-notes-section",
        "new_note_button": "button[data-action='new-visit-note']"
      },
      "fields": {
        "soap.subjective.chief_complaint": {
          "selector": "#visit_note_subjective textarea.chief-complaint",
          "fallback_selector": "textarea[name='subjective_chief_complaint']",
          "type": "textarea",
          "action": "fill",
          "required": true
        },
        "soap.subjective.pain_scale": {
          "selector": "select[name='pain_level']",
          "fallback_selector": "#pain-scale-dropdown",
          "type": "select",
          "action": "select_option",
          "required": true
        },
        "soap.subjective.pain_location": {
          "selector": "input[name='pain_location']",
          "type": "input",
          "action": "fill",
          "required": false
        },
        "soap.subjective.patient_report": {
          "selector": "#subjective-narrative textarea",
          "type": "textarea",
          "action": "fill",
          "required": true
        },
        "soap.objective.vital_signs.bp": {
          "selector_systolic": "input[name='bp_systolic']",
          "selector_diastolic": "input[name='bp_diastolic']",
          "type": "split_input",
          "action": "fill_split",
          "transform": "split_bp",
          "required": true
        },
        "soap.objective.vital_signs.hr": {
          "selector": "input[name='heart_rate']",
          "type": "input",
          "action": "fill",
          "required": true
        },
        "soap.objective.vital_signs.rr": {
          "selector": "input[name='resp_rate']",
          "type": "input",
          "action": "fill",
          "required": false
        },
        "soap.objective.vital_signs.spo2": {
          "selector": "input[name='spo2']",
          "type": "input",
          "action": "fill",
          "required": false
        },
        "soap.objective.rom_measurements": {
          "selector": "#rom-table",
          "type": "dynamic_table",
          "action": "fill_rom_table",
          "row_selector": ".rom-row",
          "add_row_button": "button.add-rom-row",
          "columns": {
            "joint": "select.rom-joint",
            "motion": "select.rom-motion",
            "arom": "input.rom-arom",
            "prom": "input.rom-prom"
          },
          "required": false
        },
        "soap.objective.strength": {
          "selector": "#strength-table",
          "type": "dynamic_table",
          "action": "fill_strength_table",
          "row_selector": ".strength-row",
          "add_row_button": "button.add-strength-row",
          "columns": {
            "muscle_group": "input.strength-muscle",
            "mmt_grade": "select.strength-grade"
          },
          "required": false
        },
        "soap.objective.functional_assessment.transfers": {
          "selector": "select[name='transfer_status']",
          "type": "select",
          "action": "select_option",
          "required": true
        },
        "soap.objective.functional_assessment.ambulation": {
          "selector": "textarea[name='ambulation_status']",
          "type": "textarea",
          "action": "fill",
          "required": true
        },
        "soap.objective.functional_assessment.balance": {
          "selector": "textarea[name='balance_status']",
          "type": "textarea",
          "action": "fill",
          "required": false
        },
        "soap.objective.edema": {
          "selector": "textarea[name='edema_notes']",
          "type": "textarea",
          "action": "fill",
          "required": false
        },
        "soap.assessment.progress": {
          "selector": "#assessment-progress textarea",
          "type": "textarea",
          "action": "fill",
          "required": true
        },
        "soap.assessment.skilled_need": {
          "selector": "#assessment-skilled-need textarea",
          "type": "textarea",
          "action": "fill",
          "required": true
        },
        "soap.assessment.homebound_status": {
          "selector": "#homebound-status textarea",
          "type": "textarea",
          "action": "fill",
          "required": true
        },
        "soap.plan.treatment_provided": {
          "selector": "#treatment-provided textarea",
          "type": "textarea",
          "action": "fill",
          "transform": "join_list",
          "required": true
        },
        "soap.plan.patient_response": {
          "selector": "textarea[name='patient_response']",
          "type": "textarea",
          "action": "fill",
          "required": true
        },
        "soap.plan.next_visit": {
          "selector": "input[name='next_visit_date']",
          "type": "date_input",
          "action": "fill_date",
          "required": true
        },
        "soap.plan.frequency": {
          "selector": "textarea[name='visit_frequency']",
          "type": "textarea",
          "action": "fill",
          "required": true
        },
        "soap.plan.goals_update": {
          "selector": "#goals-update textarea",
          "type": "textarea",
          "action": "fill",
          "required": false
        },
        "soap.plan.discharge_planning": {
          "selector": "#discharge-plan textarea",
          "type": "textarea",
          "action": "fill",
          "required": false
        }
      }
    },
