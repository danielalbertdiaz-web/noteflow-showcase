# ============================================================
# NoteFlow Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control — it contains PHI-adjacent secrets.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# Full async DSN for SQLAlchemy + asyncpg
DATABASE_URL=postgresql+asyncpg://noteflow:noteflow@localhost:5432/noteflow

# Postgres password used by docker-compose to create the DB user
POSTGRES_PASSWORD=noteflow_dev_2026

# ------------------------------------------------------------
# Redis / Celery broker
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# Auth — JWT
# ------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-random-64-char-string
JWT_ALGORITHM=HS256

# Separate secret for magic-link tokens (email login)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MAGIC_LINK_SECRET=change-me-to-random-64-char-string

# Token expiry (seconds). 3600 = 1 hour access, 604800 = 7 days refresh
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# ------------------------------------------------------------
# AI / Transcription
# ------------------------------------------------------------
# Deepgram — speech-to-text for audio note transcription
# https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key

# Anthropic Claude — note generation and SOAP structuring
# https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# ------------------------------------------------------------
# Billing — Stripe
# ------------------------------------------------------------
# Test keys start with sk_test_ and pk_test_
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ID for the NoteFlow subscription plan
STRIPE_PRICE_ID=price_xxx

# ------------------------------------------------------------
# Cloud Storage — AWS S3 (PHI-compliant bucket)
# ------------------------------------------------------------
# IAM user with s3:GetObject, s3:PutObject, s3:DeleteObject on the bucket
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
# Bucket must have server-side encryption (SSE-S3 or SSE-KMS) enabled
AWS_S3_BUCKET=noteflow-phi
AWS_REGION=us-east-1

# ------------------------------------------------------------
# Field-level Encryption (PHI)
# ------------------------------------------------------------
# 32-byte key encoded as base64. Rotate periodically.
# Generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=your-32-byte-base64-encryption-key

# ------------------------------------------------------------
# Kinnser EMR Integration
# ------------------------------------------------------------
KINNSER_BASE_URL=https://www.kinnser.net

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# Comma-separated list of allowed origins for the FastAPI CORS middleware
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
# LOG_LEVEL=info

# ------------------------------------------------------------
# Observability — Sentry
# ------------------------------------------------------------
# Leave blank to disable Sentry error reporting
SENTRY_DSN=

# ------------------------------------------------------------
# Frontend (Next.js public variables)
# ------------------------------------------------------------
# Must be prefixed NEXT_PUBLIC_ to be available in the browser bundle
NEXT_PUBLIC_API_URL=http://localhost:8000
